{
  "entries": [
    {
      "name": "@nova-ai/acpx",
      "description": "Nova AI ACP runtime backend",
      "source": "official",
      "kind": "plugin",
      "nova-ai": {
        "plugin": {
          "id": "acpx",
          "label": "ACPX Runtime"
        },
        "install": {
          "npmSpec": "@nova-ai/acpx",
          "defaultChoice": "npm",
          "minHostVersion": ">=2026.4.25"
        }
      }
    },
    {
      "name": "@nova-ai/brave-plugin",
      "description": "Nova AI Brave plugin",
      "source": "official",
      "kind": "plugin",
      "nova-ai": {
        "plugin": {
          "id": "brave",
          "label": "Brave"
        },
        "webSearchProviders": [
          {
            "id": "brave",
            "label": "Brave Search",
            "hint": "Brave Search web results.",
            "onboardingScopes": ["text-inference"],
            "credentialLabel": "Brave Search API key",
            "envVars": ["BRAVE_API_KEY"],
            "placeholder": "BSA...",
            "signupUrl": "https://api-dashboard.search.brave.com/app/keys",
            "docsUrl": "https://docs.nova-ai.com/tools/brave-search",
            "credentialPath": "plugins.entries.brave.config.webSearch.apiKey",
            "autoDetectOrder": 10
          }
        ],
        "install": {
          "npmSpec": "@nova-ai/brave-plugin",
          "defaultChoice": "npm",
          "minHostVersion": ">=2026.4.10",
          "allowInvalidConfigRecovery": true
        }
      }
    },
