{
  "name": "@nova-ai/synology-chat",
  "version": "2026.5.19",
  "description": "Synology Chat channel plugin for Nova AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-ai/nova-ai"
  },
  "type": "module",
  "devDependencies": {
    "@nova-ai/plugin-sdk": "workspace:*"
  },
  "nova-ai": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "synology-chat",
      "label": "Synology Chat",
      "selectionLabel": "Synology Chat (Webhook)",
      "docsPath": "/channels/synology-chat",
      "docsLabel": "synology-chat",
      "blurb": "Connect your Synology NAS Chat to Nova AI with full agent capabilities.",
      "order": 90
    },
    "install": {
      "npmSpec": "@nova-ai/synology-chat",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.19"
    },
    "build": {
      "nova-aiVersion": "2026.5.19"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
