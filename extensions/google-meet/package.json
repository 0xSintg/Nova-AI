{
  "name": "@nova-ai/google-meet",
  "version": "2026.5.19",
  "description": "Nova AI Google Meet participant plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-ai/nova-ai"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@nova-ai/plugin-sdk": "workspace:*",
    "nova-ai": "workspace:*"
  },
  "peerDependencies": {
    "nova-ai": ">=2026.5.19"
  },
  "peerDependenciesMeta": {
    "nova-ai": {
      "optional": true
    }
  },
  "nova-ai": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@nova-ai/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.5.19"
    },
    "build": {
      "nova-aiVersion": "2026.5.19"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
