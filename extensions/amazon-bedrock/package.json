{
  "name": "@nova-ai/amazon-bedrock-provider",
  "version": "2026.5.19",
  "description": "Nova AI Amazon Bedrock provider plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-ai/nova-ai"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1047.0",
    "@aws-sdk/client-bedrock-runtime": "3.1045.0",
    "@aws-sdk/credential-provider-node": "3.972.41",
    "@earendil-works/pi-ai": "0.75.1",
    "@smithy/shared-ini-file-loader": "4.5.2"
  },
  "devDependencies": {
    "@nova-ai/plugin-sdk": "workspace:*"
  },
  "nova-ai": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@nova-ai/amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.5.19"
    },
    "build": {
      "nova-aiVersion": "2026.5.19",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
